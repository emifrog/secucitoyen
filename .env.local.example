# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Clé service_role (SECRET, serveur uniquement) : requise pour les opérations
# sur push_subscriptions / sent_notifications et le seed. NE JAMAIS exposer.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# URL publique du site (origine de confiance pour les appels serveur→serveur)
# Domaine de production canonique — évite l'usurpation via l'en-tête Host.
NEXT_PUBLIC_SITE_URL=https://secucitoyen.vercel.app

# Sentry - Monitoring des erreurs
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_ORG=your_sentry_org
SENTRY_PROJECT=secucitoyen
SENTRY_AUTH_TOKEN=your_sentry_auth_token

# Web Push Notifications (VAPID)
# Générer avec: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:contact@secucitoyen.fr

# API Key pour l'envoi de notifications (sécurité)
# Générer avec: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NOTIFICATIONS_API_KEY=your_random_api_key

# Vercel Cron : secret fort OBLIGATOIRE (le placeholder est rejeté par le code)
# Générer avec: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=your_cron_secret
